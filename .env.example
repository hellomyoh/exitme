# 복사해서 .env 로 저장 후 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# --- KIS Open API (한국투자증권) --- 키는 https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# prod = 실전투자(openapi.koreainvestment.com:9443) / vps = 모의투자(openapivts.koreainvestment.com:29443)
KIS_ENV=prod

# --- Database / Cache ---
POSTGRES_USER=stocklab
POSTGRES_PASSWORD=stocklab-dev-password
POSTGRES_DB=stocklab
DATABASE_URL=postgresql+psycopg://stocklab:stocklab-dev-password@db:5432/stocklab
REDIS_URL=redis://redis:6379/0

# --- Auth / Crypto (운영 배포 전 반드시 새 값으로 교체) ---
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me-32bytes-base64
